    "verify:meta": "node scripts/verify-meta.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "og:build": "node scripts/build-og-images.mjs",
    "contrast:check": "node scripts/verify-dark-plate-contrast.mjs",
    "test:endpoints": "node scripts/test-request-paths.mjs",
    "test:events": "node scripts/test-events.mjs",
    "test:referral": "node scripts/test-referral.mjs",
    "test:emails": "node scripts/test-emails.mjs",
    "test:purge": "node scripts/test-account-purge.mjs",
    "test:deadlines": "node scripts/test-deadlines.mjs",
    "test:scorecard": "node scripts/test-scorecard.mjs",
    "test:outreach": "node scripts/test-outreach.mjs",
