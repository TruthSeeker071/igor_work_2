{
  "name": "flightway-site",
  "version": "0.2.0",
  "private": true,
  "description": "Flightway career-quiz site + AI coach (Cloudflare Pages Functions).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "smoke": "bash scripts/smoke.sh",
    "onet:build": "node scripts/onet-etl/build.mjs && node scripts/onet-etl/build-ai-exposure.mjs",
    "onet:exposure": "node scripts/onet-etl/build-ai-exposure.mjs",
    "onet:test": "node scripts/onet-etl/test-math.mjs",
    "onet:seed": "node scripts/onet-etl/generate-d1-seed.mjs",
    "derive:career": "node scripts/derive-career.mjs",
    "hub:verify": "node scripts/verify-hub-data.mjs && node scripts/verify-hub-lod.mjs",
    "hub:smoke": "node scripts/smoke-hub-load.mjs",
    "pages:smoke": "node scripts/smoke-pages.mjs",
    "hub:verify:full": "npm run hub:verify && npm run hub:smoke && npm run pages:smoke",
    "deploy": "node scripts/pages-deploy.mjs flightway ${CF_PAGES_BRANCH:-main}",
    "deploy:prototype": "node scripts/pages-deploy.mjs flightwayprototype Jacob_Work",
    "deploy:cron": "npx wrangler deploy --config workers/cron/wrangler.toml",
    "test:vectors": "node scripts/test-vectors.cjs",
    "grounding:check": "node scripts/test-grounding.mjs",
    "test:opportunities": "node scripts/test-opportunities.mjs",
    "resume:ui-check": "node scripts/smoke-resume-ui.mjs",
    "resume:format-check": "node scripts/test-resume-formats.mjs",
    "resume:ats-check": "node scripts/test-resume-ats.cjs",
    "resume:tailor-check": "node scripts/test-resume-tailor.cjs",
    "interview:check": "node scripts/test-interview.mjs",
    "test:weekly": "node scripts/test-weekly-plan.mjs",
    "test:entitlements": "node scripts/test-entitlements.mjs",
    "stripe:check": "node scripts/test-stripe.mjs",
    "verify:aliases": "node scripts/verify-slug-aliases.mjs",
    "sim:pregen": "node scripts/pregen-sims.mjs",
    "hero:check": "node scripts/smoke-hero-title.mjs",
    "test:school": "node scripts/test-school.mjs",
    "test:user": "node scripts/test-user-model.mjs",
    "verify:user": "node scripts/verify-user-model.mjs",
    "test:sync": "node scripts/test-user-sync.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "test:jobs": "node scripts/test-jobs.mjs",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "umap-js": "^1.4.0"
  },
  "type": "module"
}
