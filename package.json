    "test:marco-voice": "node scripts/test-marco-voice.mjs",
    "test:chat-turn": "node scripts/test-chat-turn.mjs",
    "test:intro": "node scripts/test-feature-intro.mjs",
    "test:quiz-funnel": "node scripts/test-quiz-funnel.mjs",
