# Copy to .dev.vars for local `wrangler pages dev` (never commit .dev.vars)
GEMINI_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=Flightway <onboarding@resend.dev>
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_RESUME_MODEL=gemini-2.5-flash-lite
GEMINI_USE_SEARCH=never

# Billing (free/paid merge §3). Test-mode values only in local dev; the real
# prototype/production values live as Cloudflare Pages env vars and are never
# committed. Absent → GET /config reports stripeEnabled:false and pricing.html
# keeps its fake-door intent modal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_SPRINT=

# Developer/tester full access (free/paid merge §3.5). Comma-separated emails;
# empty or unset is a global no-op. Set per environment in the Pages dashboard.
DEV_TEST_EMAILS=

# Admin console (migration 0016). The ROOT admin — the only account that can
# manage sub-admins — is defined ONLY here/in the Pages dashboard, never in D1,
# so no SQL write can mint or remove it. Unset → nobody is root and every
# /admin/* endpoint answers 404.
ROOT_ADMIN_EMAIL=

# Weekly-digest unsubscribe tokens (V2 S2). The SAME value must be set on both
# Pages projects AND the standalone flightway-cron Worker: the cron builds the
# link and Pages verifies it, so if the three stores disagree every unsubscribe
# link 403s. Unset → falls back to SESSION_PEPPER (Pages) or a committed
# constant (cron), which is exactly how they came to disagree. Warned loudly at
# runtime now; `npm run verify:env` prints the rotate-everywhere command.
UNSUB_SECRET=

# CAN-SPAM §7704(a)(5): every commercial email must carry a valid physical
# postal address. Unset → the footer falls back to the company name, which is
# not an address. Blocks the first bulk send, not today's deployment.
MAILING_ADDRESS=

# Optional (V2 S2): Cloudflare Turnstile on the contact form. BOTH halves or
# NEITHER — the site key is served publicly on /config so the widget can render,
# the secret is verified server-side in functions/contact.js. Unset (the default
# everywhere today) → no challenge, no external script request, forms unchanged.
# Free: Cloudflare dashboard → Turnstile → add site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
